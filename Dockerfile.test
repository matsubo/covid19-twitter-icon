# Test image: the production runtime (see Dockerfile) plus the development/test
# gem groups and the spec suite, so rspec and rubocop run against the same
# Ruby and ImageMagick that ship in the app image.
#
#   docker build -f Dockerfile.test -t covid19-twitter-icon:test .
#   docker run --rm covid19-twitter-icon:test                     # rspec
#   docker run --rm covid19-twitter-icon:test bundle exec rubocop # lint
FROM ruby:4-slim

# build-essential: the locked json and prism gems compile native extensions.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential imagemagick libmagickwand-dev pngquant zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Gemfile Gemfile.lock ./
RUN bundle install --jobs 4

COPY . .

CMD ["bundle", "exec", "rspec"]
